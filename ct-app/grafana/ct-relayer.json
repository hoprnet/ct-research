        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(max(ct_peer_qualifying_channels{address=\"$relayer\", hoprd_network=~\"$network\"}) >= bool $min_channels)",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "refId": "A"
